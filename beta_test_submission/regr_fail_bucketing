#!/usr/bin/env sh
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LOKY_MAX_CPU_COUNT="${LOKY_MAX_CPU_COUNT:-8}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"

INPUT=""
OUTPUT=""
K=""
PREV=""
for ARG in "$@"; do
  case "$PREV" in
    --input) INPUT="$ARG" ;;
    --output) OUTPUT="$ARG" ;;
    --k) K="$ARG" ;;
  esac
  case "$ARG" in
    --input=*) INPUT=${ARG#--input=} ;;
    --output=*) OUTPUT=${ARG#--output=} ;;
    --k=*) K=${ARG#--k=} ;;
  esac
  PREV="$ARG"
done

FAST_BIN="${BETA_FAST_BIN:-$SCRIPT_DIR/fast/regr_fail_bucketing_fast/regr_fail_bucketing_fast}"
MULTIVIEW_BIN="$SCRIPT_DIR/multiview/regr_fail_bucketing_multiview"
FULL_BIN="$SCRIPT_DIR/regr_fail_bucketing_full"

if [ -z "$INPUT" ] || [ ! -f "$INPUT" ] || [ -z "$OUTPUT" ] || [ -z "$K" ]; then
  echo "[beta-router] invalid required arguments; delegating to full backend" >&2
  exec "$FULL_BIN" "$@"
fi

N_CASES=$(awk 'END { print (NR > 0) ? NR - 1 : 0 }' "$INPUT")
EXPECTED_LINES=$((N_CASES + 1))

# The official runtime table is two-dimensional: case count and maximum
# context lines. The interface exposes neither benchmark id nor max-lines
# tier, so estimate context volume from filesystem metadata only. Do not open
# trace logs here: trace remains disabled in the formal default path.
estimate_context_stats() {
  INPUT_DIR=$(dirname -- "$INPUT")
  PLAIN_BYTES=$(find "$INPUT_DIR" -type f -name '*.log' -printf '%s\n' 2>/dev/null \
    | awk '{ total += $1 } END { printf "%.0f", total + 0 }')
  GZIP_BYTES=$(find "$INPUT_DIR" -type f -name '*.log.gz' -printf '%s\n' 2>/dev/null \
    | awk '{ total += $1 } END { printf "%.0f", total + 0 }')
  # Public data measures about 128 uncompressed or 20-25 compressed bytes per
  # context line. This estimate only decides whether to reserve more fallback
  # time; it can never raise the conservative Final watchdog above 100 seconds.
  EST_LINES=$((PLAIN_BYTES / 128 + GZIP_BYTES / 24))
  echo "$PLAIN_BYTES $GZIP_BYTES $EST_LINES"
}

CONTEXT_STATS=$(estimate_context_stats)
PLAIN_CONTEXT_BYTES=${CONTEXT_STATS%% *}
CONTEXT_STATS_REST=${CONTEXT_STATS#* }
GZIP_CONTEXT_BYTES=${CONTEXT_STATS_REST%% *}
EST_CONTEXT_LINES=${CONTEXT_STATS_REST#* }
CONTEXT_BYTES=$((PLAIN_CONTEXT_BYTES + GZIP_CONTEXT_BYTES))
# A 20M trigger leaves margin above the official 10M tier; estimates near the
# boundary retain the shorter 100-second policy.
LONG_CONTEXT_EST_LINES="${BETA_LONG_CONTEXT_EST_LINES:-20000000}"

valid_output() {
  [ -s "$OUTPUT" ] || return 1
  HEADER=$(sed -n '1{s/\r$//;p;}' "$OUTPUT")
  [ "$HEADER" = "Case,bucket" ] || return 1
  ACTUAL_LINES=$(awk 'END { print NR }' "$OUTPUT")
  [ "$ACTUAL_LINES" -eq "$EXPECTED_LINES" ] || return 1
}

# A shell watchdog avoids relying on the host's timeout binary. The packaged
# backends run in one process, so terminating the child also terminates a hung
# embedding request or pairwise calculation.
run_timed() {
  LIMIT=$1
  shift
  # A stale output must never be accepted after a failed backend invocation.
  rm -f "$OUTPUT" 2>/dev/null || true
  "$@" &
  CHILD_PID=$!
  (
    sleep "$LIMIT"
    kill -TERM "$CHILD_PID" 2>/dev/null || exit 0
    sleep 1
    kill -KILL "$CHILD_PID" 2>/dev/null || true
  ) &
  WATCHDOG_PID=$!
  if wait "$CHILD_PID"; then
    STATUS=0
  else
    STATUS=$?
  fi
  kill "$WATCHDOG_PID" 2>/dev/null || true
  wait "$WATCHDOG_PID" 2>/dev/null || true
  return "$STATUS"
}

# Last-resort output: singleton buckets yield TNR=1 and generally BA=0.5,
# which is materially safer than a failed benchmark scoring zero.
emergency_singletons() {
  echo "[beta-router] using emergency singleton output" >&2
  OUT_DIR=$(dirname -- "$OUTPUT")
  mkdir -p "$OUT_DIR" 2>/dev/null || true
  TMP_OUTPUT="${OUTPUT}.emergency.$$"
  if awk -F',' '
    BEGIN { print "Case,bucket" }
    NR > 1 {
      case_id=$1
      sub(/^\xef\xbb\xbf/, "", case_id)
      sub(/^"/, "", case_id)
      sub(/"$/, "", case_id)
      sub(/\r$/, "", case_id)
      printf "%s,bucket_emergency_%06d\n", case_id, NR - 2
    }
  ' "$INPUT" > "$TMP_OUTPUT" && mv -f "$TMP_OUTPUT" "$OUTPUT" && valid_output; then
    return 0
  fi
  rm -f "$TMP_OUTPUT" 2>/dev/null || true
  return 1
}

run_fast_or_emergency() {
  METHOD=$1
  LIMIT=$2
  shift 2
  echo "[beta-router] trying deterministic $METHOD fallback (limit=${LIMIT}s)" >&2
  if run_timed "$LIMIT" "$FAST_BIN" "$@" --llm-mode none --cluster "$METHOD" && valid_output; then
    return 0
  fi
  echo "[beta-router] deterministic fallback failed or produced invalid output" >&2
  emergency_singletons
}

if [ "$N_CASES" -le 30 ] && [ "$K" -le 4 ]; then
  RUNTIME_CLASS="public_1m"
  FINAL_LIMIT=30
  # Reserve explicit process-kill and emergency-writer grace.
  PRIMARY_LIMIT=18
  FAST_FALLBACK_LIMIT=7
elif [ "$EST_CONTEXT_LINES" -ge "$LONG_CONTEXT_EST_LINES" ]; then
  # B_QA_20260612 does not expose a benchmark/max-lines tier to the program.
  # A 100M-looking input could still be a 100-second benchmark after an
  # imperfect byte-to-line estimate, so keep the shortest applicable hidden
  # limit and reserve more of it for deterministic recovery.
  RUNTIME_CLASS="extended_context_conservative"
  FINAL_LIMIT=100
  PRIMARY_LIMIT=75
  FAST_FALLBACK_LIMIT=15
else
  RUNTIME_CLASS="regular_10m"
  FINAL_LIMIT=100
  PRIMARY_LIMIT=85
  FAST_FALLBACK_LIMIT=10
fi

echo "[beta-router] cases=$N_CASES k=$K context_disk_bytes=$CONTEXT_BYTES estimated_lines=$EST_CONTEXT_LINES class=$RUNTIME_CLASS final_limit=${FINAL_LIMIT}s" >&2

if [ -z "${LLM_MODEL_CONFIG:-}" ]; then
  if [ "$N_CASES" -le "${BETA_AGGLOM_MAX_CASES:-900}" ]; then
    run_fast_or_emergency agglomerative "$PRIMARY_LIMIT" "$@" && exit 0
  else
    run_fast_or_emergency kmeans "$PRIMARY_LIMIT" "$@" --cluster-factor 1.0 && exit 0
  fi
  exit 1
fi

if [ "$N_CASES" -le "${BETA_MULTIVIEW_MAX_CASES:-160}" ] && [ -x "$MULTIVIEW_BIN" ]; then
  MULTIVIEW_TIMEOUT="${BETA_MULTIVIEW_WALL_TIMEOUT:-$PRIMARY_LIMIT}"
  echo "[beta-router] trying canonical multi-view (limit=${MULTIVIEW_TIMEOUT}s)" >&2
  if run_timed "$MULTIVIEW_TIMEOUT" "$MULTIVIEW_BIN" "$@" && valid_output; then
    exit 0
  fi
  echo "[beta-router] multi-view failed, timed out, or produced invalid output" >&2
  run_fast_or_emergency agglomerative "$FAST_FALLBACK_LIMIT" "$@" && exit 0
  exit 1
fi

if [ "$N_CASES" -le "${BETA_FULL_MAX_CASES:-300}" ]; then
  FULL_TIMEOUT="${BETA_FULL_WALL_TIMEOUT:-$PRIMARY_LIMIT}"
  echo "[beta-router] trying calibrated dual backend (limit=${FULL_TIMEOUT}s)" >&2
  if run_timed "$FULL_TIMEOUT" "$FULL_BIN" "$@" && valid_output; then
    exit 0
  fi
  echo "[beta-router] calibrated dual failed, timed out, or produced invalid output" >&2
  run_fast_or_emergency agglomerative "$FAST_FALLBACK_LIMIT" "$@" && exit 0
  exit 1
fi

if [ "$N_CASES" -le "${BETA_AGGLOM_MAX_CASES:-900}" ]; then
  run_fast_or_emergency agglomerative "$PRIMARY_LIMIT" "$@" && exit 0
else
  run_fast_or_emergency kmeans "$PRIMARY_LIMIT" "$@" --cluster-factor 1.0 && exit 0
fi

exit 1
