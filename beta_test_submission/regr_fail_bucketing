#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LOKY_MAX_CPU_COUNT="${LOKY_MAX_CPU_COUNT:-8}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"

INPUT=""
PREV=""
for ARG in "$@"; do
  if [ "$PREV" = "--input" ]; then
    INPUT="$ARG"
    break
  fi
  case "$ARG" in
    --input=*)
      INPUT=${ARG#--input=}
      break
      ;;
  esac
  PREV="$ARG"
done

if [ -z "$INPUT" ] || [ ! -f "$INPUT" ]; then
  exec "$SCRIPT_DIR/regr_fail_bucketing_full" "$@"
fi

N_CASES=$(($(wc -l < "$INPUT") - 1))
if [ "$N_CASES" -lt 0 ]; then
  N_CASES=0
fi

FAST_BIN="$SCRIPT_DIR/fast/regr_fail_bucketing_fast/regr_fail_bucketing_fast"
MULTIVIEW_BIN="$SCRIPT_DIR/multiview/regr_fail_bucketing_multiview"

if [ "$N_CASES" -le "${BETA_MULTIVIEW_MAX_CASES:-64}" ] \
  && [ -x "$MULTIVIEW_BIN" ] \
  && [ -n "${LLM_MODEL_CONFIG:-}" ]; then
  MULTIVIEW_TIMEOUT="${BETA_MULTIVIEW_WALL_TIMEOUT:-45}"
  if command -v timeout >/dev/null 2>&1; then
    if timeout "$MULTIVIEW_TIMEOUT" "$MULTIVIEW_BIN" "$@"; then
      exit 0
    fi
  elif "$MULTIVIEW_BIN" "$@"; then
    exit 0
  fi
  echo "[beta-router] multi-view failed or timed out; using calibrated dual fallback" >&2
fi


if [ "$N_CASES" -le "${BETA_FULL_MAX_CASES:-300}" ]; then
  exec "$SCRIPT_DIR/regr_fail_bucketing_full" "$@"
elif [ "$N_CASES" -le "${BETA_AGGLOM_MAX_CASES:-900}" ]; then
  exec "$FAST_BIN" "$@" --llm-mode none --cluster agglomerative
else
  exec "$FAST_BIN" "$@" --llm-mode none --cluster kmeans --cluster-factor 1.0
fi
