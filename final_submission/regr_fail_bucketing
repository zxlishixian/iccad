#!/usr/bin/env bash
set -u

# regr_fail_bucketing --input IN.csv --output OUT.csv --k K
#
# Always emits a valid Case,bucket CSV, even on timeout or crash:
#   1. write a singleton fallback (one bucket per case) immediately;
#   2. run the TriLog ensemble in final_inference.py (which itself falls back
#      to the deterministic Drain+SVD+agglomerative baseline on any error);
#   3. a watchdog kills the Python process at the runtime budget, preserving
#      the singleton if it has not yet been replaced.

INPUT=""; OUTPUT=""; K=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --input) INPUT="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --k) K="$2"; shift 2 ;;
    *) shift ;;
  esac
done

HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${PYTHON:-python3}"

if [ -z "$INPUT" ] || [ -z "$OUTPUT" ]; then
  echo "usage: regr_fail_bucketing --input IN.csv --output OUT.csv --k K" >&2
  exit 2
fi

# 1. Singleton emergency output (each case its own bucket). The first column
#    of the input CSV is used as the case id, matching the official Case column.
if [ -f "$INPUT" ]; then
  mkdir -p "$(dirname "$OUTPUT")" 2>/dev/null || true
  awk -F, 'NR==1 { print "Case,bucket" } NR>1 { printf "%s,bucket_%03d\n", $1, NR-2 }' "$INPUT" > "$OUTPUT"
fi

# 2. Runtime budget from case count (official limits).
N=0
if [ -f "$INPUT" ]; then N=$(( $(wc -l < "$INPUT") - 1 )); fi
LIMIT=100
[ "$N" -le 30 ] && LIMIT=30
[ "$N" -gt 3000 ] && LIMIT=300

# 3. Run Python inference in the background.
"$PY" "$HERE/final_inference.py" --input "$INPUT" --output "$OUTPUT" --k "${K:-1}" \
  --model-dir "$HERE" >/dev/null 2>"$HERE/inference.log" &
PID=$!

# 4. Watchdog: kill at the limit; the singleton survives on failure/timeout.
( sleep "$LIMIT"; kill -9 "$PID" 2>/dev/null ) &
WATCHDOG=$!
wait "$PID" 2>/dev/null
RC=$?
kill "$WATCHDOG" 2>/dev/null

exit "$RC"
