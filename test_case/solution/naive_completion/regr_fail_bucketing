#!/usr/bin/env python3

import argparse
import asyncio
import gzip
import os
import random
import re
import sys

import agents
import openai
import pandas as pd
import pydantic
import yaml

agents.set_tracing_disabled(disabled=True)


def open_file(filepath):
    """Return a file-like object in text mode for either gzipped or plain text files."""
    if filepath.endswith(".gz"):
        return gzip.open(filepath, "rt")
    return open(filepath, "r")


class CaseBucketPair(pydantic.BaseModel):
    """Pair of a case-bucket"""
    case_id: int = pydantic.Field(..., description="1-indexed integer case ID")
    bucket: str = pydantic.Field(..., description="Assigned bucket label")

class ClusteringInput(pydantic.BaseModel):
    """Input arguments for clustering function tool"""
    buckets: list[CaseBucketPair] = pydantic.Field(..., description="Case-bucket pairs")

@agents.function_tool
async def clustering(args: ClusteringInput):
    """Assign each case to a bucket."""
    return args.buckets


def load_model_config():
    """Load completion model settings from the LLM_MODEL_CONFIG environment variable.

    The env var value may be either inline YAML content or a path to a YAML file.
    YAML structure (per the competition spec):
        completion:
          model_name: "gpt-4o"
          config:
            api_key: "<API-KEY>"
            base_url: "<BASE-URL>"
            client_library: "openai.AsyncOpenAI"
            model: "<MODEL-PROVIDER>"
    """
    raw = os.environ.get("LLM_MODEL_CONFIG", "")
    if not raw:
        raise RuntimeError("LLM_MODEL_CONFIG environment variable is not set")
    if os.path.isfile(raw):
        with open(raw, "r") as f:
            cfg = yaml.safe_load(f)
    else:
        cfg = yaml.safe_load(raw)
    completion = cfg.get("completion", {})
    return completion.get("config", {}), completion.get("model_name", "")


async def run(args):
    seed = 42
    random.seed(seed)
    os.environ["PYTHONHASHSEED"] = str(seed)

    model_cfg, model_name = load_model_config()
    client = openai.AsyncOpenAI(
        api_key=model_cfg.get("api_key", ""),
        base_url=model_cfg.get("base_url", model_cfg.get("azure_endpoint", "")),
    )
    model = model_cfg.get("model", model_name)
    agent = agents.Agent(
        name="Clustering agent",
        instructions="Call `clustering` function tool to group RTL regression failure cases.",
        model=agents.OpenAIChatCompletionsModel(model=model, openai_client=client),
        tools=[clustering],
        model_settings=agents.ModelSettings(tool_choice="clustering", temperature=0.0),
    )

    uvm_pattern = re.compile(r"^(UVM_FATAL.*|UVM_ERROR.*)")
    instr_pattern = re.compile(r"^\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.*)")

    df_input = pd.read_csv(args.input)

    prompt = []
    prompt.append("Each of the following cases contains the snippets of three logs:")
    prompt.append("- sim.log: the first matched line of UVM_ERROR or UVM_FATAL.")
    prompt.append("- trace.log: the instructions of the last 10 lines of trace.")
    prompt.append("- regr.log: the report from the checker.")
    prompt.append(f"For each of the following {len(df_input)} cases, assign it to one of bucket_1 to bucket_{args.k}.")
    prompt.append(f"Return exactly {len(df_input)} case-bucket pairs, one for each case.")

    for _, row in df_input.iterrows():
        case_id = row["Case"]
        regr_path = row["Regr Log"]
        sim_path = row["Sim Log"]
        trace_path = row["Trace Log"]

        prompt.append(f'<case id="{case_id}">')
        prompt.append("  <sim.log>")
        with open_file(sim_path) as f:
            for line in f:
                m = uvm_pattern.search(line)
                if m:
                    prompt.append(m.group(0))
                    break
        prompt.append("  </sim.log>")
        prompt.append("  <trace.log>")
        with open_file(trace_path) as f:
            for line in f.read().splitlines()[-10:]:
                m = instr_pattern.search(line)
                if m:
                    prompt.append(m.group(5))
        prompt.append("  </trace.log>")
        prompt.append("  <regr.log>")
        with open_file(regr_path) as f:
            prompt += f.read().splitlines()
        prompt.append("  </regr.log>")
        prompt.append(f'</case id="{case_id}">')

    df_output = pd.DataFrame()
    for _ in range(3):
        result = await agents.Runner.run(agent, "\n".join(prompt))
        for item in result.new_items:
            if type(item).__name__ == "ToolCallOutputItem":
                df_output = pd.DataFrame(
                    data=[[pair.case_id, pair.bucket] for pair in item.output],
                    columns=["Case", "bucket"],
                )
        if not df_output.empty:
            break

    df_output.to_csv(args.output, index=False)


def main():
    parser = argparse.ArgumentParser(
        description="Regression failure bucketing via LLM naive completion"
    )
    parser.add_argument("--input", required=True, help="Input CSV with log file paths")
    parser.add_argument("--output", required=True, help="Output CSV with bucket assignments")
    parser.add_argument("--k", type=int, required=True, help="Number of clusters")
    args = parser.parse_args()

    asyncio.run(run(args))


if __name__ == "__main__":
    main()
