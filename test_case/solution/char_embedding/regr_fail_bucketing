#!/usr/bin/env python3

import argparse
import gzip
import os
import random
import re
import sys

import numpy as np
import pandas as pd
import sklearn.cluster


def open_file(filepath):
    """Return a file-like object in text mode for either gzipped or plain text files."""
    if filepath.endswith(".gz"):
        return gzip.open(filepath, "rt")
    return open(filepath, "r")


def calculate_ngram(in_string):
    out_ngram = np.zeros(128, dtype=float)
    for i in range(len(in_string)):
        code = ord(in_string[i])
        if code < 128:
            out_ngram[code] += 1
    return out_ngram


def main():
    seed = 42
    random.seed(seed)
    os.environ["PYTHONHASHSEED"] = str(seed)
    np.random.seed(seed)

    parser = argparse.ArgumentParser(
        description="Regression failure bucketing via character-frequency embedding"
    )
    parser.add_argument("--input", required=True, help="Input CSV with log file paths")
    parser.add_argument("--output", required=True, help="Output CSV with bucket assignments")
    parser.add_argument("--k", type=int, required=True, help="Number of clusters")
    args = parser.parse_args()

    uvm_pattern = re.compile(r"^(UVM_FATAL.*|UVM_ERROR.*)")
    instr_pattern = re.compile(r"^\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.*)")

    df_input = pd.read_csv(args.input)

    rows = []
    for _, row in df_input.iterrows():
        regr_path = row["Regr Log"]
        sim_path = row["Sim Log"]
        trace_path = row["Trace Log"]

        sim_embedding = np.zeros(128, dtype=float)
        with open_file(sim_path) as f:
            for line in f:
                m = uvm_pattern.search(line)
                if m:
                    sim_embedding = calculate_ngram(m.group(0))
                    break

        trace_embedding = np.zeros(128, dtype=float)
        with open_file(trace_path) as f:
            for line in f.read().splitlines()[-10:]:
                m = instr_pattern.search(line)
                if m:
                    trace_embedding += calculate_ngram(m.group(5))

        regr_embedding = np.zeros(128, dtype=float)
        with open_file(regr_path) as f:
            regr_embedding += calculate_ngram(f.read())

        rows.append(np.concatenate([sim_embedding, trace_embedding, regr_embedding]))

    X = np.vstack(rows)

    agg = sklearn.cluster.AgglomerativeClustering(n_clusters=args.k, linkage="ward")
    labels = agg.fit_predict(X)

    df_output = pd.DataFrame({"Case": df_input["Case"].values, "bucket": labels})
    df_output.to_csv(args.output, index=False)


if __name__ == "__main__":
    main()
